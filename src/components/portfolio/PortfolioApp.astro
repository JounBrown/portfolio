                </div>
              </div>
            </article>
          ))
        ) : (
          <p class="col-span-2 text-center text-gray-500 py-10">No projects found.</p>
        )}
      </div>
    </section>

    <!-- Socials Section -->
    <section id="socials" class="border border-gray-300 flex flex-col mb-16">
