      </div>
      <div class="p-8 grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-10">
        
        <!-- Mail -->
        <a href="mailto:vsvrrara@gmail.com" target="_blank" class="flex items-start gap-4 group cursor-pointer hover:bg-gray-50 p-2 -m-2 rounded transition-colors">
          <div class="w-14 h-14 flex-shrink-0 flex items-center justify-center bg-white rounded shadow-sm border border-gray-200">
            <svg viewBox="0 0 48 48" class="w-10 h-10">
              <path fill="#4caf50" d="M45,16.2l-5,2.75l-5,4.75V40h7.5C43.88,40,45,38.88,45,37.5V16.2z"/>
              <path fill="#1e88e5" d="M3,16.2l3.614,1.71L13,23.7V40H5.5C4.12,40,3,38.88,3,37.5V16.2z"/>
              <polygon fill="#e53935" points="35,11.2 24,19.45 13,11.2 12,17 13,23.7 24,31.95 35,23.7 36,17"/>
              <path fill="#c62828" d="M3,12.298V16.2l10,7.5V11.2L9.876,8.859C9.132,8.301,8.228,8,7.298,8h0C4.924,8,3,9.924,3,12.298z"/>
              <path fill="#fbc02d" d="M45,12.298V16.2l-10,7.5V11.2l3.124-2.341C38.868,8.301,39.772,8,40.702,8h0 C43.076,8,45,9.924,45,12.298z"/>
            </svg>
          </div>
          <div>
            <h3 class="text-blue-700 font-bold text-[17px] leading-tight group-hover:underline">Mail</h3>
            <p class="text-gray-800 text-[15px] mt-1 leading-snug">Easiest way to contact me. Avg response time: 12 hr</p>
          </div>
        </a>

        <!-- LinkedIn -->
        <a href="https://www.linkedin.com/in/juandav-moreno" target="_blank" class="flex items-start gap-4 group cursor-pointer hover:bg-gray-50 p-2 -m-2 rounded transition-colors">
          <div class="w-14 h-14 flex-shrink-0 flex items-center justify-center bg-[#0A66C2] rounded shadow-sm border border-transparent">
            <svg viewBox="0 0 24 24" class="w-8 h-8" fill="white">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </div>
          <div>
            <h3 class="text-blue-700 font-bold text-[17px] leading-tight group-hover:underline">LinkedIn</h3>
            <p class="text-gray-800 text-[15px] mt-1 leading-snug">Connect professionally & explore my experience</p>
          </div>
        </a>

        <!-- GitHub -->
        <a href="https://github.com/jounBrown" target="_blank" class="flex items-start gap-4 group cursor-pointer hover:bg-gray-50 p-2 -m-2 rounded transition-colors">
          <div class="w-14 h-14 flex-shrink-0 flex items-center justify-center bg-[#181717] rounded shadow-sm border border-transparent">
            <svg viewBox="0 0 24 24" class="w-9 h-9" fill="white">
              <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
            </svg>
          </div>
          <div>
            <h3 class="text-blue-700 font-bold text-[17px] leading-tight group-hover:underline">GitHub</h3>
            <p class="text-gray-800 text-[15px] mt-1 leading-snug">Check out my code, open-source contributions & side projects</p>
          </div>
        </a>

      </div>
    </section>

    </div> <!-- END HOME VIEW -->

    <!-- VISTAS DE DETALLES DE EXPERIENCE -->
    {experiences.map(async (experience: any) => {
      const { Content } = await render(experience);
      return (
        <div id={`project-view-${experience.id}`} class="project-detail-view hidden flex-col gap-10 animate-fade-in">

          <!-- Header Section (Image & Metadata) -->
          <div class="flex flex-col xl:flex-row gap-10 items-start mt-0">
            <div class="w-full xl:w-7/12 flex-shrink-0">
              <Image 
                src={experience.data.coverImage} 
                alt={experience.data.title} 
                class="w-full h-auto object-cover" 
              />
            </div>
            <div class="w-full xl:w-5/12 flex flex-col gap-6">
              <h1 class="!text-2xl font-serif text-black leading-tight">{experience.data.title}</h1>
              <p class="text-gray-700 text-lg leading-relaxed">{experience.data.description}</p>
              
              {experience.data.tags && experience.data.tags.length > 0 && (
                <div class="flex flex-wrap gap-2 mt-2">
                  {experience.data.tags.map((tag: any) => (
                    <span class="text-xs bg-gray-100 text-gray-800 px-3 py-1 rounded-sm border border-gray-300 font-mono tracking-tight shadow-sm hover:bg-gray-200 transition-colors cursor-default">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
              



              {(experience.data.liveUrl || experience.data.repoUrl) && (
                <div class="flex gap-4 mt-6">
                  {experience.data.liveUrl && (
                    <a href={experience.data.liveUrl} target="_blank" tabindex="-1">
                      <button type="button" class="cursor-pointer px-8 py-3 text-xl font-bold">
                        Ver aplicación
                      </button>
                    </a>
                  )}
                  {experience.data.repoUrl && (
                    <a href={experience.data.repoUrl} target="_blank" tabindex="-1">
                      <button type="button" class="cursor-pointer px-8 py-3 text-xl font-bold">
                        Ver repositorio
                      </button>
                    </a>
                  )}
                </div>
              )}
            </div>
          </div>
          
          <!-- Markdown Body -->
          <div class="prose prose-lg prose-blue max-w-none prose-headings:font-serif prose-headings:font-normal pb-10 border-t border-gray-300
                      prose-img:w-full prose-img:max-w-none prose-img:my-8
                      prose-blockquote:bg-[#e6f4ea] prose-blockquote:border-l-4 prose-blockquote:border-green-600 prose-blockquote:px-6 prose-blockquote:py-4 prose-blockquote:not-italic prose-blockquote:text-gray-800 prose-blockquote:shadow-sm">
            <Content />
          </div>

          <!-- Tech Stack Section -->
          {experience.data.techStack && experience.data.techStack.length > 0 && (
            <div class="border-t border-gray-300 pt-10 pb-20">
              <h2 class="text-3xl font-serif font-normal mb-8 text-gray-900">Stack Tecnológico</h2>
              <div class="grid grid-cols-5 gap-8">
                {experience.data.techStack.map((tech: any) => (
                  <div class="flex flex-col items-center gap-3 p-4 border border-gray-200 bg-gray-50 hover:bg-white hover:shadow-md transition-all duration-200 group">
                    <div class="w-16 h-16 flex items-center justify-center">
                      <img 
                        src={resolveTechIcon(tech.icon)} 
                        alt={tech.name}
                        class="w-full h-full object-contain group-hover:scale-110 transition-transform duration-200"
                      />
                    </div>
                    <span class="text-sm font-medium text-gray-700 text-center leading-tight">{tech.name}</span>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      );
    })}

    <!-- VISTAS DE DETALLES DE PROYECTOS -->
    {projects.map(async (project: any) => {
      const { Content } = await render(project);
      return (
        <div id={`project-view-${project.id}`} class="project-detail-view hidden flex-col gap-10 animate-fade-in">

          <!-- Header Section (Image & Metadata) -->
          <div class="flex flex-col xl:flex-row gap-10 items-start mt-0">
            <div class="w-full xl:w-7/12 flex-shrink-0">
              <Image 
                src={project.data.coverImage} 
                alt={project.data.title} 
                class="w-full h-auto object-cover" 
              />
            </div>
            <div class="w-full xl:w-5/12 flex flex-col gap-6">
              <h1 class="!text-2xl font-serif text-black leading-tight">{project.data.title}</h1>
              <p class="text-gray-700 text-lg leading-relaxed">{project.data.description}</p>
              
              {project.data.tags && project.data.tags.length > 0 && (
                <div class="flex flex-wrap gap-2 mt-2">
                  {project.data.tags.map((tag: any) => (
                    <span class="text-xs bg-gray-100 text-gray-800 px-3 py-1 rounded-sm border border-gray-300 font-mono tracking-tight shadow-sm hover:bg-gray-200 transition-colors cursor-default">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
              


              {(project.data.liveUrl || project.data.repoUrl) && (
                <div class="flex gap-4 mt-6">
                  {project.data.liveUrl && (
                    <a href={project.data.liveUrl} target="_blank" tabindex="-1">
                      <button type="button" class="cursor-pointer px-8 py-3 text-xl font-bold">
                        Ver aplicación
                      </button>
                    </a>
                  )}
                  {project.data.repoUrl && (
                    <a href={project.data.repoUrl} target="_blank" tabindex="-1">
                      <button type="button" class="cursor-pointer px-8 py-3 text-xl font-bold">
                        Ver repositorio
                      </button>
                    </a>
                  )}
                </div>
              )}
            </div>
          </div>
          
          <!-- Markdown Body -->
          <div class="prose prose-lg prose-blue max-w-none prose-headings:font-serif prose-headings:font-normal pb-10 border-t border-gray-300
                      prose-blockquote:bg-[#e6f4ea] prose-blockquote:border-l-4 prose-blockquote:border-green-600 prose-blockquote:px-6 prose-blockquote:py-4 prose-blockquote:not-italic prose-blockquote:text-gray-800 prose-blockquote:shadow-sm">
            <Content />
          </div>

          <!-- Tech Stack Section -->
          {project.data.techStack && project.data.techStack.length > 0 && (
            <div class="border-t border-gray-300 pt-10 pb-20">
              <h2 class="text-3xl font-serif font-normal mb-8 text-gray-900">Stack Tecnológico</h2>
              <div class="grid grid-cols-5 gap-8">
                {project.data.techStack.map((tech: any) => (
                  <div class="flex flex-col items-center gap-3 p-4 border border-gray-200 bg-gray-50 hover:bg-white hover:shadow-md transition-all duration-200 group">
                    <div class="w-16 h-16 flex items-center justify-center">
                      <img 
                        src={tech.icon} 
                        alt={tech.name}
                        class="w-full h-full object-contain group-hover:scale-110 transition-transform duration-200"
                      />
                    </div>
                    <span class="text-sm font-medium text-gray-700 text-center leading-tight">{tech.name}</span>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      );
    })}

  </main>
</div>

<style>
  .animate-fade-in {
    animation: fadeIn 0.3s ease-out forwards;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const homeView = document.getElementById('home-view');
    const sidebar = document.getElementById('portfolio-sidebar');
    const projectViews = document.querySelectorAll('.project-detail-view');
    const cardBtns = document.querySelectorAll('.project-card-btn');
    const mainScroll = document.getElementById('portfolio-main-scroll');

    // Toolbar Back Button
    const windowFrame = homeView?.closest('.window') || document;
    const toolbarBackBtn = windowFrame.querySelector('.toolbar-back-button');

    // Show Project Detail
    cardBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const projectId = btn.getAttribute('data-project-id');
        const targetView = document.getElementById(`project-view-${projectId}`);
        
        if (homeView && targetView) {
          homeView.classList.add('hidden');
          homeView.classList.remove('flex');
          
          if (sidebar) {
            sidebar.classList.add('hidden');
            sidebar.classList.remove('flex');
          }
          
          targetView.classList.remove('hidden');
          targetView.classList.add('flex');

          // Scroll to top of main container
          if (mainScroll) mainScroll.scrollTop = 0;
        }
      });
    });

    // Go Back to Home via Toolbar
    if (toolbarBackBtn) {
      toolbarBackBtn.addEventListener('click', () => {
        projectViews.forEach(view => {
          view.classList.add('hidden');
          view.classList.remove('flex');
        });
        
        if (homeView) {
          homeView.classList.remove('hidden');
          homeView.classList.add('flex');
        }
        
        if (sidebar) {
          sidebar.classList.remove('hidden');
          sidebar.classList.add('flex');
        }
      });
    }
  });
</script>
