---
import recycleIcon from '../assets/recycle_bin_full.ico?url';
import portfolioIcon from '../assets/portfolio.ico?url';
import doomIcon from '../assets/doom_icon.png?url';
---

<section class="absolute top-win-16 left-win-16 flex flex-col gap-win-16">
  <div id="portfolio-icon" class="flex w-28 flex-col items-center gap-win-8 text-win-14 text-white cursor-pointer select-none">
    <img src={portfolioIcon} alt="Portfolio" class="h-20 w-20 drop-shadow-md" />
    <span class="text-center">Portfolio</span>
  </div>
  <div id="doom-icon" class="flex w-28 flex-col items-center gap-win-8 text-win-14 text-white cursor-pointer select-none">
    <img src={doomIcon} alt="Doom" class="h-20 w-20 drop-shadow-md" />
    <span class="text-center">Doom</span>
  </div>
</section>

<section class="absolute bottom-[56px] right-win-16 flex flex-col gap-win-16">
  <div id="recycle-icon" class="flex w-28 flex-col items-center gap-win-8 text-win-14 text-white cursor-pointer select-none">
    <img src={recycleIcon} alt="Recycle Bin" class="h-20 w-20 drop-shadow-md" />
    <span class="text-center">Recycle Bin</span>
  </div>
</section>

