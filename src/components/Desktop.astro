---
import DesktopIcons from "./DesktopIcons.astro";
import WindowFrame from "./WindowFrame.astro";
import PortfolioApp from "./portfolio/PortfolioApp.astro";
import recycleIcon from "../assets/recycle_bin_full.ico?url";
import portfolioIcon from "../assets/portfolio.ico?url";
---

<main
  id="desktop-shell"
  class="relative h-screen w-screen overflow-hidden bg-desktop-bg"
>
  <div
    id="desktop-canvas"
    class="absolute left-0 top-0 origin-top-left"
    style="width: 1920px; height: 1040px;"
  >
    <DesktopIcons />

    <div
      id="recycle-window"
      class="absolute left-1/2 top-1/2 hidden -translate-x-1/2 -translate-y-1/2"
    >
      <WindowFrame
        title="Recycle Bin"
        windowId="recycle-window"
        icon={recycleIcon}
      >
        <div class="p-win-16 h-full">
          <h2 class="text-win-20 font-bold">Error 202: Love Not Found</h2>
          <p class="mt-win-8 text-win-14">
            The requested item was not found on this heart. Please check the
            address and try again.
          </p>
        </div>
      </WindowFrame>
    </div>

    <div
      id="portfolio-window"
      class="absolute left-1/2 top-1/2 hidden -translate-x-1/2 -translate-y-1/2"
    >
      <WindowFrame
        title="Portfolio"
        windowId="portfolio-window"
        icon={portfolioIcon}
        width="1400px"
        height="920px"
      >
        <PortfolioApp />
      </WindowFrame>
    </div>

    <slot />
  </div>
</main>

<script>
  import "../lib/desktop";
</script>
