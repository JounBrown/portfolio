---
import arrowIcon from "../assets/arrow.ico?url";
import errorIcon from "../assets/error.ico?url";
import refreshIcon from "../assets/refresh.ico?url";
import homeIcon from "../assets/home.ico?url";
import searchIcon from "../assets/search_web.ico?url";
import favoritesIcon from "../assets/directory_favorites.ico?url";
import printIcon from "../assets/printer.ico?url";
import explorerPageIcon from "../assets/explorer_page.ico?url";

const {
  title = "Portfolio Explorer",
  showMenu = true,
  showToolbar = true,
  showAddress = true,
  windowId = "window",
  icon = "/favicon.ico",
} = Astro.props;
---

<div
  class="window flex flex-col w-full max-w-content bg-[#c0c0c0]"
  data-window-id={windowId}
  data-window-title={title}
  style="width: 1081px; height: 717px;"
>
  <div
    class="title-bar bg-titlebar-active text-white"
    style="cursor: move; user-select: none; touch-action: none;"
  >
    <div
      class="window-header flex w-full items-center justify-between gap-win-8 px-win-8"
    >
      <div class="flex items-center gap-win-8">
        <img src={icon} alt="Window icon" class="h-4 w-4 shrink-0" />
        <div class="title-bar-text">{title}</div>
      </div>

      <div class="title-bar-controls">
        <button aria-label="Minimize" data-window-minimize={windowId}></button>
        <button aria-label="Maximize" data-window-maximize={windowId}></button>
        <button aria-label="Close" data-window-close={windowId}></button>
      </div>
    </div>
  </div>

  <div
    class="window-bars overflow-hidden bg-[#c0c0c0]"
    style="border: 1px solid #808080; box-shadow: inset 1px 1px 0 #ffffff, inset -1px -1px 0 #000000;"
  >
    {
      showMenu && (
        <menu class="menu-bar flex items-center gap-0">
          <div
            class="h-[25px] w-[5px] shrink-0"
            style="margin: 4px 6px 4px 5px; background: #bdbdbd; box-shadow: inset 1px 1px 0 #ffffff, inset -1px -1px 0 #000000;"
          />
          <li>
            <button class="menu-btn">
              <u>F</u>ile
            </button>
          </li>
          <li>
            <button class="menu-btn">
              <u>E</u>dit
            </button>
          </li>
          <li>
            <button class="menu-btn">
              <u>V</u>iew
            </button>
          </li>
          <li>
            <button class="menu-btn">
              <u>G</u>o
            </button>
          </li>
          <li>
            <button class="menu-btn">
              <u>F</u>avorites
            </button>
          </li>
          <li>
            <button class="menu-btn">
              <u>T</u>ools
            </button>
          </li>
          <li>
            <button class="menu-btn">
              <u>H</u>elp
            </button>
          </li>
        </menu>
      )
    }

    {
      showMenu && showToolbar && (
        <div
          class="h-[2px] shrink-0"
          style="margin: 0 1px; width: calc(100% - 3px); background: #c0c0c0; box-shadow: inset 0 1px 0 #ffffff, inset 0 -1px 0 #808080;"
        />
      )
    }

    {
      showToolbar && (
        <div
          class="window-body flex items-center gap-0 bg-[#c0c0c0] pl-0 pr-0 py-0"
          style="margin: 0;"
        >
          <div
            class="w-[5px] shrink-0"
            style="height: 38px; min-height: 38px; max-height: 38px; margin: 3px 5px 3px 5px; background: #bdbdbd; box-shadow: inset 1px 1px 0 #ffffff, inset -1px -1px 0 #000000;"
          />
          <button class="toolbar-btn toolbar-back-button">
            <img
              src={arrowIcon}
              alt="Back"
              class="h-6 w-6 shrink-0"
              style="transform: scaleX(-1);"
            />
            <span>Back</span>
          </button>
          <button class="toolbar-btn toolbar-forward-button">
            <img src={arrowIcon} alt="Forward" class="h-6 w-6 shrink-0" />
            <span>Forward</span>
          </button>
          <button class="toolbar-btn toolbar-stop-button">
            <img
              src={errorIcon}
              alt="Stop"
              class="toolbar-stop-icon h-6 w-6 shrink-0"
            />
            <span>Stop</span>
          </button>
          <button class="toolbar-btn toolbar-refresh-button">
            <img
              src={refreshIcon}
              alt="Refresh"
              class="toolbar-refresh-icon h-6 w-6 shrink-0"
            />
            <span>Refresh</span>
          </button>
          <button class="toolbar-btn toolbar-home-button">
            <img
              src={homeIcon}
              alt="Home"
              class="toolbar-home-icon h-6 w-6 shrink-0"
            />
            <span>Home</span>
          </button>
          <button class="toolbar-btn toolbar-search-button">
            <img
              src={searchIcon}
              alt="Search"
              class="toolbar-search-icon h-6 w-6 shrink-0"
            />
            <span>Search</span>
          </button>
          <button class="toolbar-btn toolbar-favorites-button">
            <img
              src={favoritesIcon}
              alt="Favorites"
              class="toolbar-favorites-icon h-6 w-6 shrink-0"
            />
            <span>Favorites</span>
          </button>
          <button class="toolbar-btn toolbar-print-button">
            <img
              src={printIcon}
              alt="Print"
              class="toolbar-print-icon h-6 w-6 shrink-0"
            />
            <span>Print</span>
          </button>
        </div>
      )
    }

    {
      showToolbar && showAddress && (
        <div
          class="h-[2px] shrink-0"
          style="margin: 0 1px; width: calc(100% - 3px); background: #c0c0c0; box-shadow: inset 0 1px 0 #ffffff, inset 0 -1px 0 #808080;"
        />
      )
    }

    {
      showAddress && (
        <div
          class="flex items-stretch bg-[#c0c0c0] pl-[5px] pr-win-8 py-[2px]"
          style="height: 33px;"
        >
          <div
            class="h-full w-[5px] shrink-0"
            style="margin: 0; background: #bdbdbd; box-shadow: inset 1px 1px 0 #ffffff, inset -1px -1px 0 #000000;"
          />
          <div class="shrink-0 h-full" style="width: 5px;" />
          <label
            class="text-win-12 flex h-full items-center"
            style="margin: 0; padding: 0 5px; box-sizing: border-box; font-size: 13px; font-weight: 505;"
          >
            Address
          </label>
          <div class="address-url-field h-full w-full">
            <input
              class="w-full h-full address-url-input"
              type="text"
              value="https://"
              style="font-size: 15px; padding-left: 4px;"
            />
          </div>
        </div>
      )
    }
  </div>

  <div class="window-content window-body flex-1 bg-white overflow-auto" style="margin: 4px; box-shadow: inset -1px -1px #fff, inset 1px 1px #0a0a0a, inset -2px -2px #dfdfdf, inset 2px 2px #808080;">
    <slot />
  </div>
</div>

<style>
  .toolbar-stop-icon {
    filter: none;
    opacity: 1;
  }

  .toolbar-refresh-icon,
  .toolbar-home-icon {
    filter: none;
    opacity: 1;
  }

  .toolbar-search-icon,
  .toolbar-favorites-icon {
    filter: none;
    opacity: 1;
  }

  .toolbar-print-icon {
    filter: none;
    opacity: 1;
  }

  .address-url-field {
    min-width: 0;
  }

  .address-url-input {
    padding-left: 5px;
    height: calc(100% - 4px);
    margin: 2px 0;
    box-sizing: border-box;
  }

</style>
<style is:global>
  .taskbar-window-button {
    min-width: 160px;
    max-width: 240px;
    height: 24px;
    display: inline-flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    gap: 6px;
    padding: 0 10px;
    border: 1px solid #808080;
    background: #c0c0c0;
    box-shadow: inset 1px 1px 0 #ffffff, inset -1px -1px 0 #000000;
    font-size: 12px;
    line-height: 1;
    white-space: nowrap;
    overflow: hidden;
  }
</style>

<script is:inline define:vars={{ windowId, title, icon }}>
  const initWindowFrame = () => {
    const windowRoot = document.querySelector(`[data-window-id="${windowId}"]`);
    const windowWrapper = windowRoot?.parentElement;
    const desktopCanvas = document.getElementById("desktop-canvas");
    const titleBar = windowRoot?.querySelector(".title-bar");
    const minimizeButton = windowRoot?.querySelector(
      `[data-window-minimize="${windowId}"]`
    );
    const maximizeButton = windowRoot?.querySelector(
      `[data-window-maximize="${windowId}"]`
    );
    const closeButton = windowRoot?.querySelector(
      `[data-window-close="${windowId}"]`
    );

    let windowRestoredClassName = windowRoot?.className ?? "";
    let windowRestoredStyle = windowRoot?.getAttribute("style") ?? "";
    let wrapperRestoredClassName = windowWrapper?.className ?? "";
    let wrapperRestoredStyle = windowWrapper?.getAttribute("style") ?? "";

    let lastClientX = 0;
    let lastClientY = 0;
    let dragPointerId = -1;
    let isDragging = false;

    const getDesktopMetrics = () => {
      const canvasRect = desktopCanvas?.getBoundingClientRect();
      const baseWidth = desktopCanvas?.offsetWidth ?? 1920;
      const baseHeight = desktopCanvas?.offsetHeight ?? 1040;
      const scale = canvasRect && baseWidth ? canvasRect.width / baseWidth : 1;

      return {
        canvasLeft: canvasRect?.left ?? 0,
        canvasTop: canvasRect?.top ?? 0,
        canvasWidth: baseWidth,
        canvasHeight: baseHeight,
        scale,
      };
    };

    const saveNormalState = () => {
      if (!windowRoot || !windowWrapper) return;

      windowRestoredClassName = windowRoot.className;
      windowRestoredStyle = windowRoot.getAttribute("style") ?? "";
      wrapperRestoredClassName = windowWrapper.className;
      wrapperRestoredStyle = windowWrapper.getAttribute("style") ?? "";
    };

    const stopDrag = () => {
      if (!isDragging) return;

      isDragging = false;
      dragPointerId = -1;
      document.body.style.userSelect = "";
      saveNormalState();
      window.removeEventListener("pointermove", onDragMove);
      window.removeEventListener("pointerup", stopDrag);
      window.removeEventListener("pointercancel", stopDrag);
    };

    const onDragMove = (event) => {
      if (!windowWrapper || !isDragging || event.pointerId !== dragPointerId)
        return;

      const { canvasWidth, canvasHeight, scale } = getDesktopMetrics();

      const deltaX = (event.clientX - lastClientX) / scale;
      const deltaY = (event.clientY - lastClientY) / scale;

      lastClientX = event.clientX;
      lastClientY = event.clientY;

      const currentLeft = parseFloat(windowWrapper.style.left || 0);
      const currentTop = parseFloat(windowWrapper.style.top || 0);

      const nextLeft = currentLeft + deltaX;
      const nextTop = currentTop + deltaY;

      const width =
        parseFloat(windowWrapper.style.width) || windowRoot.offsetWidth;
      const height =
        parseFloat(windowWrapper.style.height) || windowRoot.offsetHeight;

      const viewportWidth = window.visualViewport?.width ?? window.innerWidth;
      const viewportHeight =
        window.visualViewport?.height ?? window.innerHeight;
      const taskbarHeight =
        document.querySelector("footer")?.getBoundingClientRect().height ?? 40;

      const unscaledViewportWidth = viewportWidth / scale;
      const unscaledViewportHeight = (viewportHeight - taskbarHeight) / scale;

      const maxLeft = Math.max(0, unscaledViewportWidth - width);
      const maxTop = Math.max(0, unscaledViewportHeight - height);

      windowWrapper.style.left = `${Math.min(
        Math.max(nextLeft, 0),
        maxLeft
      )}px`;
      windowWrapper.style.top = `${Math.min(Math.max(nextTop, 0), maxTop)}px`;
    };

    const startDrag = (event) => {
      if (
        !windowRoot ||
        !windowWrapper ||
        windowRoot.dataset.windowState === "maximized"
      )
        return;
      if (event.target instanceof Element && event.target.closest("button"))
        return;

      saveNormalState();

      const { canvasWidth, canvasHeight, scale } = getDesktopMetrics();
      const currentWidth = windowRoot.offsetWidth;
      const currentHeight = windowRoot.offsetHeight;

      const viewportWidth = window.visualViewport?.width ?? window.innerWidth;
      const viewportHeight =
        window.visualViewport?.height ?? window.innerHeight;
      const taskbarHeight =
        document.querySelector("footer")?.getBoundingClientRect().height ?? 40;

      const unscaledViewportWidth = viewportWidth / scale;
      const unscaledViewportHeight = (viewportHeight - taskbarHeight) / scale;

      if (
        !windowWrapper.style.left ||
        !windowWrapper.style.left.endsWith("px") ||
        windowWrapper.style.transform !== "none"
      ) {
        const initialLeft = (unscaledViewportWidth - currentWidth) / 2;
        const initialTop = (unscaledViewportHeight - currentHeight) / 2;

        windowWrapper.style.left = `${initialLeft}px`;
        windowWrapper.style.top = `${initialTop}px`;
        windowWrapper.style.width = `${currentWidth}px`;
        windowWrapper.style.height = `${currentHeight}px`;
        windowWrapper.style.transform = "none";

        windowWrapper.classList.remove(
          "left-1/2",
          "top-1/2",
          "-translate-x-1/2",
          "-translate-y-1/2",
          "w-full",
          "max-w-content"
        );
      }

      lastClientX = event.clientX;
      lastClientY = event.clientY;
      dragPointerId = event.pointerId;
      isDragging = true;

      const maxLeft = Math.max(0, unscaledViewportWidth - currentWidth);
      const maxTop = Math.max(0, unscaledViewportHeight - currentHeight);

      document.body.style.userSelect = "none";
      window.addEventListener("pointermove", onDragMove);
      window.addEventListener("pointerup", stopDrag);
      window.addEventListener("pointercancel", stopDrag);
    };

    const isMaximized = () => windowRoot?.dataset.windowState === "maximized";

    const setMaximizedState = (nextState) => {
      if (!windowRoot || !windowWrapper) return;

      if (nextState === "maximized") {
        saveNormalState();

        const { scale } = getDesktopMetrics();
        const viewportWidth = window.visualViewport?.width ?? window.innerWidth;
        const viewportHeight =
          window.visualViewport?.height ?? window.innerHeight;
        const taskbarHeight =
          document.querySelector("footer")?.getBoundingClientRect().height ??
          40;

        const unscaledViewportWidth = viewportWidth / scale;
        const unscaledViewportHeight = (viewportHeight - taskbarHeight) / scale;

        windowWrapper.className = "absolute left-0 top-0 z-20";
        windowWrapper.style.transform = "none";
        windowWrapper.style.maxWidth = "none";
        windowWrapper.style.left = "0px";
        windowWrapper.style.top = "0px";
        windowWrapper.style.width = `${unscaledViewportWidth}px`;
        windowWrapper.style.height = `${unscaledViewportHeight}px`;
        windowWrapper.classList.remove("hidden");

        windowRoot.className = "window flex flex-col bg-[#c0c0c0]";
        windowRoot.style.width = "100%";
        windowRoot.style.height = "100%";
        windowRoot.style.maxWidth = "none";
        windowRoot.style.left = "";
        windowRoot.style.top = "";
        windowRoot.dataset.windowState = "maximized";

        maximizeButton?.setAttribute("aria-label", "Restore");
        maximizeButton?.setAttribute("title", "Restore");
        return;
      }

      windowWrapper.className = wrapperRestoredClassName;
      windowWrapper.setAttribute("style", wrapperRestoredStyle);
      windowWrapper.classList.remove("hidden");

      windowRoot.className = windowRestoredClassName;
      windowRoot.setAttribute("style", windowRestoredStyle);
      windowRoot.classList.remove("hidden");
      windowRoot.dataset.windowState = "normal";

      maximizeButton?.setAttribute("aria-label", "Maximize");
      maximizeButton?.setAttribute("title", "Maximize");
    };

    const ensureTaskbarButton = () => {
      const taskbarItems = document.getElementById("taskbar-items");
      if (!taskbarItems) return null;
      
      let taskbarButton = taskbarItems.querySelector(`[data-taskbar-window="${windowId}"]`);
      if (!taskbarButton) {
        taskbarButton = document.createElement("button");
        taskbarButton.type = "button";
        taskbarButton.className = "flex items-center justify-start gap-1 px-2 font-bold";
        taskbarButton.style.cssText = "min-width: 160px; max-width: 240px; height: 28px; line-height: 1;";
        taskbarButton.dataset.taskbarWindow = windowId;
        taskbarButton.innerHTML = `
          <img src="${icon}" alt="icon" class="h-4 w-4 shrink-0" />
          <span style="font-weight: bold;">${title}</span>
        `;
        taskbarButton.addEventListener("click", () => {
          if (windowRoot?.dataset.minimized === "true") {
            restoreWindow();
          } else {
            minimizeWindow();
          }
        });
        taskbarItems.appendChild(taskbarButton);
      }
      return taskbarButton;
    };

    const updateTaskbarState = () => {
      const btn = ensureTaskbarButton();
      if (!btn) return;
      if (windowRoot?.dataset.minimized === "true" || windowRoot?.classList.contains("hidden")) {
        btn.classList.remove("active");
        btn.style.boxShadow = "";
        btn.style.paddingTop = "";
        btn.style.paddingLeft = "";
      } else {
        btn.classList.add("active");
        btn.style.boxShadow = "inset -1px -1px #ffffff, inset 1px 1px #0a0a0a, inset -2px -2px #dfdfdf, inset 2px 2px #808080";
        btn.style.paddingTop = "2px";
        btn.style.paddingLeft = "10px";
      }
    };

    const restoreWindow = () => {
      if (!windowRoot) return;
      windowRoot.classList.remove("hidden");
      windowWrapper?.classList.remove("hidden");
      windowRoot.dataset.minimized = "false";
      saveNormalState();
      updateTaskbarState();
    };

    const minimizeWindow = () => {
      if (!windowRoot) return;
      windowRoot.classList.add("hidden");
      windowRoot.dataset.minimized = "true";
      updateTaskbarState();
    };

    const toggleMaximizeWindow = () => {
      if (!windowRoot || !windowWrapper) return;

      if (isMaximized()) {
        setMaximizedState("normal");
        return;
      }

      setMaximizedState("maximized");
    };

    minimizeButton?.addEventListener("click", minimizeWindow);
    maximizeButton?.addEventListener("click", toggleMaximizeWindow);
    titleBar?.addEventListener("pointerdown", startDrag);
    closeButton?.addEventListener("click", () => {
      stopDrag();
      document
        .getElementById("taskbar-items")
        ?.querySelector(`[data-taskbar-window="${windowId}"]`)
        ?.remove();
      setMaximizedState("normal");
      windowRoot?.classList.add("hidden");
      windowWrapper?.classList.add("hidden");
      windowRoot?.dataset.minimized && (windowRoot.dataset.minimized = "false");
    });

    if (!windowRoot?.classList.contains("hidden") && !windowWrapper?.classList.contains("hidden")) {
      updateTaskbarState();
    }

    document.addEventListener("pointerdown", (event) => {
      // Si la ventana ya está oculta o minimizada, no hacer nada
      if (
        windowRoot?.classList.contains("hidden") ||
        windowRoot?.dataset.minimized === "true" ||
        windowWrapper?.classList.contains("hidden")
      ) return;

      // Si el clic es dentro de la ventana, no hacer nada
      if (windowWrapper?.contains(event.target) || windowRoot?.contains(event.target)) return;

      // Si el clic es en su propio botón de la barra de tareas, no hacer nada
      // (el botón ya tiene su propia lógica de toggle)
      const taskbarBtn = document.querySelector(`[data-taskbar-window="${windowId}"]`);
      if (taskbarBtn?.contains(event.target)) return;

      // Si es un clic externo, se minimiza
      minimizeWindow();
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initWindowFrame, {
      once: true,
    });
  } else {
    initWindowFrame();
  }
</script>

<style>
  .menu-btn {
    min-width: 0;
    min-height: 0;
    background: transparent;
    box-shadow: none;
    border: none;
    padding: 4px 10px;
    font-family: inherit;
    font-size: 16px;
    color: inherit;
    cursor: default;
    outline: none;
  }
  .menu-btn:hover {
    box-shadow: inset -1px -1px #0a0a0a, inset 1px 1px #fff,
      inset -2px -2px #808080, inset 2px 2px #dfdfdf;
  }
  .menu-btn:active {
    box-shadow: inset -1px -1px #fff, inset 1px 1px #0a0a0a,
      inset -2px -2px #dfdfdf, inset 2px 2px #808080;
    padding: 5px 9px 3px 11px;
  }
  .toolbar-btn {
    min-width: 75px;
    min-height: 46px;
    background: transparent !important;
    box-shadow: none !important;
    border: none !important;
    padding: 4px 6px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0px;
    font-family: inherit;
    font-size: 15px;
    color: inherit;
    cursor: default;
    outline: none;
  }
  .toolbar-btn:hover {
    box-shadow: inset -1px -1px #0a0a0a, inset 1px 1px #fff,
      inset -2px -2px #808080, inset 2px 2px #dfdfdf !important;
  }
  .toolbar-btn:active {
    box-shadow: inset -1px -1px #fff, inset 1px 1px #0a0a0a,
      inset -2px -2px #dfdfdf, inset 2px 2px #808080 !important;
    padding: 5px 5px 3px 7px;
  }
  .toolbar-btn img {
    filter: grayscale(1) !important;
    opacity: 0.6 !important;
    transition: filter 0s, opacity 0s;
  }
  .toolbar-btn:hover img,
  .toolbar-btn:active img {
    filter: none !important;
    opacity: 1 !important;
  }
  .toolbar-btn.toolbar-back-button img,
  .toolbar-btn.toolbar-forward-button img,
  .toolbar-btn.toolbar-back-button:hover img,
  .toolbar-btn.toolbar-forward-button:hover img,
  .toolbar-btn.toolbar-back-button:active img,
  .toolbar-btn.toolbar-forward-button:active img {
    filter: grayscale(1) brightness(0.2) saturate(0) !important;
    opacity: 0.75 !important;
  }
</style>
