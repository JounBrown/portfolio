---
import arrowIcon from '../assets/arrow.ico?url';
import errorIcon from '../assets/error.ico?url';
import refreshIcon from '../assets/refresh.ico?url';
import homeIcon from '../assets/home.ico?url';
import searchIcon from '../assets/search_web.ico?url';
import favoritesIcon from '../assets/directory_favorites.ico?url';
import printIcon from '../assets/printer.ico?url';
import explorerPageIcon from '../assets/explorer_page.ico?url';

const {
  title = 'Portfolio Explorer',
  showMenu = true,
  showToolbar = true,
  showAddress = true,
  windowId = 'window'
} = Astro.props;
---

<div class="window w-full max-w-content bg-ui-light" data-window-id={windowId} data-window-title={title} style="width: 1081px; height: 717px;">
  <div class="title-bar bg-titlebar-active text-white" style="cursor: move; user-select: none; touch-action: none;">
    <div class="window-header flex w-full items-center justify-between gap-win-8 px-win-8">
      <div class="flex items-center gap-win-8">
        <img src="/favicon.ico" alt="Window icon" class="h-4 w-4 shrink-0" />
        <div class="title-bar-text">{title}</div>
      </div>

      <div class="title-bar-controls">
        <button aria-label="Minimize" data-window-minimize={windowId}></button>
        <button aria-label="Maximize" data-window-maximize={windowId}></button>
        <button aria-label="Close" data-window-close={windowId}></button>
      </div>
    </div>
  </div>

  <div
    class="window-bars overflow-hidden bg-ui-light"
    style="border: 1px solid #808080; box-shadow: inset 1px 1px 0 #ffffff, inset -1px -1px 0 #000000;"
  >
    {showMenu && (
      <menu class="menu-bar flex items-center gap-0">
        <div
          class="h-[25px] w-[5px] shrink-0"
          style="margin: 4px 6px 4px 5px; background: #bdbdbd; box-shadow: inset 1px 1px 0 #ffffff, inset -1px -1px 0 #000000;"
        ></div>
        <li><button class="button"><u>F</u>ile</button></li>
        <li><button class="button"><u>E</u>dit</button></li>
        <li><button class="button"><u>V</u>iew</button></li>
        <li><button class="button"><u>G</u>o</button></li>
        <li><button class="button"><u>F</u>avorites</button></li>
        <li><button class="button"><u>T</u>ools</button></li>
        <li><button class="button"><u>H</u>elp</button></li>
      </menu>
    )}

    {showMenu && showToolbar && (
      <div
        class="h-[2px] shrink-0"
        style="margin: 0 1px; width: calc(100% - 3px); background: #c0c0c0; box-shadow: inset 0 1px 0 #ffffff, inset 0 -1px 0 #808080;"
      ></div>
    )}

    {showToolbar && (
      <div class="window-body flex items-center gap-0 bg-ui-light pl-0 pr-0 py-0" style="margin: 0;">
        <div
          class="w-[5px] shrink-0"
          style="height: 38px; min-height: 38px; max-height: 38px; margin: 3px 5px 3px 5px; background: #bdbdbd; box-shadow: inset 1px 1px 0 #ffffff, inset -1px -1px 0 #000000;"
        ></div>
        <button class="button toolbar-icon-button toolbar-back-button" style="padding-top: 3px; padding-bottom: 3px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; background: #c0c0c0;">
          <img src={arrowIcon} alt="Back" class="h-4 w-4 shrink-0" style="transform: scaleX(-1); filter: grayscale(1) brightness(0.2) saturate(0); opacity: 0.75;" />
          <span>Back</span>
        </button>
        <button class="button toolbar-icon-button toolbar-forward-button" style="padding-top: 3px; padding-bottom: 3px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; background: #c0c0c0;">
          <img src={arrowIcon} alt="Forward" class="h-4 w-4 shrink-0" style="filter: grayscale(1) brightness(0.2) saturate(0); opacity: 0.75;" />
          <span>Forward</span>
        </button>
        <button class="button toolbar-icon-button toolbar-stop-button" style="padding-top: 3px; padding-bottom: 3px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; background: #c0c0c0;">
          <img src={errorIcon} alt="Stop" class="toolbar-stop-icon h-4 w-4 shrink-0" />
          <span>Stop</span>
        </button>
        <button class="button toolbar-icon-button toolbar-refresh-button" style="padding-top: 3px; padding-bottom: 3px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; background: #c0c0c0;">
          <img src={refreshIcon} alt="Refresh" class="toolbar-refresh-icon h-4 w-4 shrink-0" />
          <span>Refresh</span>
        </button>
        <button class="button toolbar-icon-button toolbar-home-button" style="padding-top: 3px; padding-bottom: 3px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; background: #c0c0c0;">
          <img src={homeIcon} alt="Home" class="toolbar-home-icon h-4 w-4 shrink-0" />
          <span>Home</span>
        </button>
        <button class="button toolbar-icon-button toolbar-search-button" style="padding-top: 3px; padding-bottom: 3px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; background: #c0c0c0;">
          <img src={searchIcon} alt="Search" class="toolbar-search-icon h-4 w-4 shrink-0" />
          <span>Search</span>
        </button>
        <button class="button toolbar-icon-button toolbar-favorites-button" style="padding-top: 3px; padding-bottom: 3px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; background: #c0c0c0;">
          <img src={favoritesIcon} alt="Favorites" class="toolbar-favorites-icon h-4 w-4 shrink-0" />
          <span>Favorites</span>
        </button>
        <button class="button toolbar-icon-button toolbar-print-button" style="padding-top: 3px; padding-bottom: 3px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; background: #c0c0c0;">
          <img src={printIcon} alt="Print" class="toolbar-print-icon h-4 w-4 shrink-0" />
          <span>Print</span>
        </button>
      </div>
    )}

    {showToolbar && showAddress && (
      <div
        class="h-[2px] shrink-0"
        style="margin: 0 1px; width: calc(100% - 3px); background: #c0c0c0; box-shadow: inset 0 1px 0 #ffffff, inset 0 -1px 0 #808080;"
      ></div>
    )}

    {showAddress && (
      <div class="flex items-stretch bg-ui-light pl-[5px] pr-win-8" style="height: 28px;">
        <div
          class="h-[25px] w-[5px] shrink-0 self-start"
          style="margin: 0; background: #bdbdbd; box-shadow: inset 1px 1px 0 #ffffff, inset -1px -1px 0 #000000;"
        ></div>
        <div class="shrink-0 h-full" style="width: 5px;"></div>
        <label class="text-win-12 flex h-full items-center" style="margin: 0; padding: 0 5px; box-sizing: border-box; font-size: 13px; font-weight: 505;">Address</label>
        <div class="address-url-field h-full w-full">
          <input
            class="w-full address-url-input"
            type="text"
            value="https://"
            
          />
        </div>
      </div>
    )}
  </div>

  <div class="window-content window-body">
    <slot />
  </div>
</div>

<style>
  .toolbar-stop-icon {
    filter: none;
    opacity: 1;
  }

  .toolbar-refresh-icon,
  .toolbar-home-icon {
    filter: none;
    opacity: 1;
  }

  .toolbar-search-icon,
  .toolbar-favorites-icon {
    filter: none;
    opacity: 1;
  }

  .toolbar-print-icon {
    filter: none;
    opacity: 1;
  }

  .address-url-field {
    min-width: 0;
  }

  .address-url-input {
    padding-left: 5px;
    height: calc(100% - 4px);
    margin: 2px 0;
    box-sizing: border-box;
  }

  .taskbar-window-button {
    min-width: 160px;
    max-width: 240px;
    height: 24px;
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    gap: 6px;
    padding: 0 10px;
    border: 1px solid #808080;
    background: #c0c0c0;
    box-shadow: inset 1px 1px 0 #ffffff, inset -1px -1px 0 #000000;
    font-size: 12px;
    line-height: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>

<script is:inline define:vars={{ windowId, title }}>
  const initWindowFrame = () => {
    const windowRoot = document.querySelector(`[data-window-id="${windowId}"]`);
    const windowWrapper = windowRoot?.parentElement;
    const desktopCanvas = document.getElementById('desktop-canvas');
    const titleBar = windowRoot?.querySelector('.title-bar');
    const minimizeButton = windowRoot?.querySelector(`[data-window-minimize="${windowId}"]`);
    const maximizeButton = windowRoot?.querySelector(`[data-window-maximize="${windowId}"]`);
    const closeButton = windowRoot?.querySelector(`[data-window-close="${windowId}"]`);

    let windowRestoredClassName = windowRoot?.className ?? '';
    let windowRestoredStyle = windowRoot?.getAttribute('style') ?? '';
    let wrapperRestoredClassName = windowWrapper?.className ?? '';
    let wrapperRestoredStyle = windowWrapper?.getAttribute('style') ?? '';

    let lastClientX = 0;
    let lastClientY = 0;
    let dragPointerId = -1;
    let isDragging = false;

    const getDesktopMetrics = () => {
      const canvasRect = desktopCanvas?.getBoundingClientRect();
      const baseWidth = desktopCanvas?.offsetWidth ?? 1920;
      const baseHeight = desktopCanvas?.offsetHeight ?? 1040;
      const scale = canvasRect && baseWidth ? canvasRect.width / baseWidth : 1;

      return {
        canvasLeft: canvasRect?.left ?? 0,
        canvasTop: canvasRect?.top ?? 0,
        canvasWidth: baseWidth,
        canvasHeight: baseHeight,
        scale
      };
    };

    const saveNormalState = () => {
      if (!windowRoot || !windowWrapper) return;

      windowRestoredClassName = windowRoot.className;
      windowRestoredStyle = windowRoot.getAttribute('style') ?? '';
      wrapperRestoredClassName = windowWrapper.className;
      wrapperRestoredStyle = windowWrapper.getAttribute('style') ?? '';
    };

    const stopDrag = () => {
      if (!isDragging) return;

      isDragging = false;
      dragPointerId = -1;
      document.body.style.userSelect = '';
      saveNormalState();
      window.removeEventListener('pointermove', onDragMove);
      window.removeEventListener('pointerup', stopDrag);
      window.removeEventListener('pointercancel', stopDrag);
    };

    const onDragMove = (event) => {
      if (!windowWrapper || !isDragging || event.pointerId !== dragPointerId) return;

      const { canvasWidth, canvasHeight, scale } = getDesktopMetrics();
      
      const deltaX = (event.clientX - lastClientX) / scale;
      const deltaY = (event.clientY - lastClientY) / scale;

      lastClientX = event.clientX;
      lastClientY = event.clientY;

      const currentLeft = parseFloat(windowWrapper.style.left || 0);
      const currentTop = parseFloat(windowWrapper.style.top || 0);

      const nextLeft = currentLeft + deltaX;
      const nextTop = currentTop + deltaY;

      const width = parseFloat(windowWrapper.style.width) || windowRoot.offsetWidth;
      const height = parseFloat(windowWrapper.style.height) || windowRoot.offsetHeight;

      const viewportWidth = window.visualViewport?.width ?? window.innerWidth;
      const viewportHeight = window.visualViewport?.height ?? window.innerHeight;
      const taskbarHeight = document.querySelector('footer')?.getBoundingClientRect().height ?? 40;

      const unscaledViewportWidth = viewportWidth / scale;
      const unscaledViewportHeight = (viewportHeight - taskbarHeight) / scale;

      const maxLeft = Math.max(0, unscaledViewportWidth - width);
      const maxTop = Math.max(0, unscaledViewportHeight - height);

      windowWrapper.style.left = `${Math.min(Math.max(nextLeft, 0), maxLeft)}px`;
      windowWrapper.style.top = `${Math.min(Math.max(nextTop, 0), maxTop)}px`;
    };

    const startDrag = (event) => {
      if (!windowRoot || !windowWrapper || windowRoot.dataset.windowState === 'maximized') return;
      if (event.target instanceof Element && event.target.closest('button')) return;

      saveNormalState();

      const { canvasWidth, canvasHeight, scale } = getDesktopMetrics();
      const currentWidth = windowRoot.offsetWidth;
      const currentHeight = windowRoot.offsetHeight;

      const viewportWidth = window.visualViewport?.width ?? window.innerWidth;
      const viewportHeight = window.visualViewport?.height ?? window.innerHeight;
      const taskbarHeight = document.querySelector('footer')?.getBoundingClientRect().height ?? 40;

      const unscaledViewportWidth = viewportWidth / scale;
      const unscaledViewportHeight = (viewportHeight - taskbarHeight) / scale;

      if (!windowWrapper.style.left || !windowWrapper.style.left.endsWith('px') || windowWrapper.style.transform !== 'none') {
        const initialLeft = (unscaledViewportWidth - currentWidth) / 2;
        const initialTop = (unscaledViewportHeight - currentHeight) / 2;
        
        windowWrapper.style.left = `${initialLeft}px`;
        windowWrapper.style.top = `${initialTop}px`;
        windowWrapper.style.width = `${currentWidth}px`;
        windowWrapper.style.height = `${currentHeight}px`;
        windowWrapper.style.transform = 'none';
        
        windowWrapper.classList.remove('left-1/2', 'top-1/2', '-translate-x-1/2', '-translate-y-1/2', 'w-full', 'max-w-content');
      }

      lastClientX = event.clientX;
      lastClientY = event.clientY;
      dragPointerId = event.pointerId;
      isDragging = true;

      const maxLeft = Math.max(0, unscaledViewportWidth - currentWidth);
      const maxTop = Math.max(0, unscaledViewportHeight - currentHeight);

      document.body.style.userSelect = 'none';
      window.addEventListener('pointermove', onDragMove);
      window.addEventListener('pointerup', stopDrag);
      window.addEventListener('pointercancel', stopDrag);
    };

    const isMaximized = () => windowRoot?.dataset.windowState === 'maximized';

    const setMaximizedState = (nextState) => {
      if (!windowRoot || !windowWrapper) return;

      if (nextState === 'maximized') {
        saveNormalState();
        
        const { scale } = getDesktopMetrics();
        const viewportWidth = window.visualViewport?.width ?? window.innerWidth;
        const viewportHeight = window.visualViewport?.height ?? window.innerHeight;
        const taskbarHeight = document.querySelector('footer')?.getBoundingClientRect().height ?? 40;
        
        const unscaledViewportWidth = viewportWidth / scale;
        const unscaledViewportHeight = (viewportHeight - taskbarHeight) / scale;

        windowWrapper.className = 'absolute left-0 top-0 z-20';
        windowWrapper.style.transform = 'none';
        windowWrapper.style.maxWidth = 'none';
        windowWrapper.style.left = '0px';
        windowWrapper.style.top = '0px';
        windowWrapper.style.width = `${unscaledViewportWidth}px`;
        windowWrapper.style.height = `${unscaledViewportHeight}px`;
        windowWrapper.classList.remove('hidden');

        windowRoot.className = 'window bg-ui-light';
        windowRoot.style.width = '100%';
        windowRoot.style.height = '100%';
        windowRoot.style.maxWidth = 'none';
        windowRoot.style.left = '';
        windowRoot.style.top = '';
        windowRoot.dataset.windowState = 'maximized';

        maximizeButton?.setAttribute('aria-label', 'Restore');
        maximizeButton?.setAttribute('title', 'Restore');
        return;
      }

      windowWrapper.className = wrapperRestoredClassName;
      windowWrapper.setAttribute('style', wrapperRestoredStyle);
      windowWrapper.classList.remove('hidden');

      windowRoot.className = windowRestoredClassName;
      windowRoot.setAttribute('style', windowRestoredStyle);
      windowRoot.classList.remove('hidden');
      windowRoot.dataset.windowState = 'normal';

      maximizeButton?.setAttribute('aria-label', 'Maximize');
      maximizeButton?.setAttribute('title', 'Maximize');
    };

    const restoreWindow = () => {
      if (!windowRoot) return;
      windowRoot.classList.remove('hidden');
      windowWrapper?.classList.remove('hidden');
      windowRoot.dataset.minimized = 'false';
      saveNormalState();
    };

    const minimizeWindow = () => {
      if (!windowRoot) return;

      const taskbarItems = document.getElementById('taskbar-items');
      if (!taskbarItems) return;

      windowRoot.classList.add('hidden');
      windowRoot.dataset.minimized = 'true';

      if (taskbarItems.querySelector(`[data-taskbar-window="${windowId}"]`)) return;

      const taskbarButton = document.createElement('button');
      taskbarButton.type = 'button';
      taskbarButton.className = 'taskbar-window-button';
      taskbarButton.dataset.taskbarWindow = windowId;
      taskbarButton.textContent = title;
      taskbarButton.addEventListener('click', restoreWindow);
      taskbarItems.appendChild(taskbarButton);
    };

    const toggleMaximizeWindow = () => {
      if (!windowRoot || !windowWrapper) return;

      if (isMaximized()) {
        setMaximizedState('normal');
        return;
      }

      setMaximizedState('maximized');
    };

    minimizeButton?.addEventListener('click', minimizeWindow);
    maximizeButton?.addEventListener('click', toggleMaximizeWindow);
    titleBar?.addEventListener('pointerdown', startDrag);
    closeButton?.addEventListener('click', () => {
      stopDrag();
      document.getElementById('taskbar-items')?.querySelector(`[data-taskbar-window="${windowId}"]`)?.remove();
      setMaximizedState('normal');
      windowRoot?.classList.add('hidden');
      windowWrapper?.classList.add('hidden');
      windowRoot?.dataset.minimized && (windowRoot.dataset.minimized = 'false');
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initWindowFrame, { once: true });
  } else {
    initWindowFrame();
  }
</script>
