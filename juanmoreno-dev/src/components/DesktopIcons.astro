---
import recycleIcon from '../assets/recycle_bin_full.ico?url';
---

<section class="absolute bottom-[56px] right-win-16 flex flex-col gap-win-16">
  <button id="recycle-icon" class="flex w-20 flex-col items-center gap-win-8 text-win-12 text-white">
    <img src={recycleIcon} alt="Recycle Bin" class="h-10 w-10" />
    <span class="text-center">Recycle Bin</span>
  </button>
</section>
