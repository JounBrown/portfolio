---
import windowsIcon from '../assets/windows.ico?url';
---

<footer class="fixed bottom-0 left-0 right-0 z-10 border-t border-ui-dark bg-ui-light shadow-emboss">
  <div class="flex h-10 w-full items-center gap-win-12 px-win-4">
    <button
      class="flex h-[30px] w-[70px] items-center justify-center gap-win-3 border-win border-ui-dark bg-ui-light font-bold shadow-emboss"
      style="font-size: 14px; line-height: 1;"
    >
      <img src={windowsIcon} alt="Inicio" class="h-7 w-7" />
      <span>Inicio</span>
    </button>
    <div class="h-8 w-px bg-ui-dark"></div>
    <div id="taskbar-items" class="flex flex-1 items-center gap-win-4 overflow-hidden px-win-4"></div>
    <div class="flex h-[24px] items-center border-win border-ui-mid bg-ui-light px-win-8 text-win-12 shadow-inset-emboss">
      <span id="taskbar-clock">--:--</span>
    </div>
  </div>
</footer>

  <script is:inline>
    const clock = document.getElementById('taskbar-clock');

    const updateClock = () => {
      if (!clock) return;
      const now = new Date();
      const time = new Intl.DateTimeFormat('es-ES', {
        hour: '2-digit',
        minute: '2-digit',
        hour12: true
      }).format(now);
      clock.textContent = time;
    };

    updateClock();
    setInterval(updateClock, 60 * 1000);
  </script>
