---
import DesktopIcons from "./DesktopIcons.astro";
import WindowFrame from "./WindowFrame.astro";
import PortfolioApp from "./portfolio/PortfolioApp.astro";
import recycleIcon from "../assets/recycle_bin_full.ico?url";
import portfolioIcon from "../assets/portfolio.ico?url";
---

<main
  id="desktop-shell"
  class="relative h-screen w-screen overflow-hidden bg-desktop-bg"
>
  <div
    id="desktop-canvas"
    class="absolute left-0 top-0 origin-top-left"
    style="width: 1920px; height: 1040px;"
  >
    <DesktopIcons />

    <div
      id="recycle-window"
      class="absolute left-1/2 top-1/2 hidden -translate-x-1/2 -translate-y-1/2"
    >
      <WindowFrame
        title="Recycle Bin"
        windowId="recycle-window"
        icon={recycleIcon}
      >
        <div class="p-win-16 h-full">
          <h2 class="text-win-20 font-bold">Error 202: Love Not Found</h2>
          <p class="mt-win-8 text-win-14">
            The requested item was not found on this heart. Please check the
            address and try again.
          </p>
        </div>
      </WindowFrame>
    </div>

    <div
      id="portfolio-window"
      class="absolute left-1/2 top-1/2 hidden -translate-x-1/2 -translate-y-1/2"
    >
      <WindowFrame
        title="Portfolio"
        windowId="portfolio-window"
        icon={portfolioIcon}
        width="1400px"
        height="920px"
      >
        <PortfolioApp />
      </WindowFrame>
    </div>

    <slot />
  </div>
</main>

<script
  is:inline
  define:vars={{ recycleIconUrl: recycleIcon, portfolioIconUrl: portfolioIcon }}
>
  const updateDesktopScale = () => {
    const desktopCanvas = document.getElementById("desktop-canvas");
    if (!desktopCanvas) return;

    const viewportWidth = window.visualViewport?.width ?? window.innerWidth;
    const viewportHeight = window.visualViewport?.height ?? window.innerHeight;
    const taskbarHeight =
      document.querySelector("footer")?.getBoundingClientRect().height ?? 40;
    const baseWidth = 1920;
    const baseHeight = 1040;
    const scale = Math.min(
      viewportWidth / baseWidth,
      (viewportHeight - taskbarHeight) / baseHeight,
      1
    );

    desktopCanvas.style.transform = `scale(${scale})`;
    document.documentElement.style.setProperty(
      "--desktop-scale",
      String(scale)
    );
  };

  const setupDesktopApp = (appId, title, iconUrl) => {
    const iconEl = document.getElementById(`${appId}-icon`);
    const windowEl = document.getElementById(`${appId}-window`);
    const frameEl = windowEl?.querySelector(
      `[data-window-id="${appId}-window"]`
    );
    const closeBtn = document.querySelector(
      `[data-window-close="${appId}-window"]`
    );

    const ensureTaskbarButton = () => {
      const taskbarItems = document.getElementById("taskbar-items");
      if (!taskbarItems) return null;

      let btn = taskbarItems.querySelector(
        `[data-taskbar-window="${appId}-window"]`
      );
      if (!btn) {
        btn = document.createElement("button");
        btn.type = "button";
        btn.className = "flex items-center justify-start gap-1 px-2 font-bold";
        btn.style.cssText =
          "min-width: 160px; max-width: 240px; height: 28px; line-height: 1;";
        btn.dataset.taskbarWindow = `${appId}-window`;
        btn.innerHTML = `
          <img src="${iconUrl}" alt="icon" class="h-4 w-4 shrink-0" />
          <span style="font-weight: bold;">${title}</span>
        `;
        btn.addEventListener("click", () => {
          if (
            windowEl?.classList.contains("hidden") ||
            frameEl?.classList.contains("hidden")
          ) {
            openWindow();
          } else {
            minimizeWindow();
          }
        });
        taskbarItems.appendChild(btn);
      }
      return btn;
    };

    const updateTaskbarState = () => {
      const btn = ensureTaskbarButton();
      if (!btn) return;
      if (
        windowEl?.classList.contains("hidden") ||
        frameEl?.classList.contains("hidden")
      ) {
        btn.classList.remove("active");
        btn.style.boxShadow = "";
        btn.style.paddingTop = "";
        btn.style.paddingLeft = "";
      } else {
        btn.classList.add("active");
        btn.style.boxShadow =
          "inset -1px -1px #ffffff, inset 1px 1px #0a0a0a, inset -2px -2px #dfdfdf, inset 2px 2px #808080";
        btn.style.paddingTop = "2px";
        btn.style.paddingLeft = "10px";
      }
    };

    const openWindow = () => {
      windowEl?.classList.remove("hidden");
      frameEl?.classList.remove("hidden");
      if (frameEl) frameEl.dataset.minimized = "false";
      updateTaskbarState();
    };

    const minimizeWindow = () => {
      windowEl?.classList.add("hidden");
      frameEl?.classList.add("hidden");
      if (frameEl) frameEl.dataset.minimized = "true";
      updateTaskbarState();
    };

    const closeWindow = () => {
      frameEl?.classList.add("hidden");
      windowEl?.classList.add("hidden");
      const taskbarItems = document.getElementById("taskbar-items");
      taskbarItems
        ?.querySelector(`[data-taskbar-window="${appId}-window"]`)
        ?.remove();
    };

    if (iconEl && windowEl) {
      iconEl.addEventListener("dblclick", () => {
        openWindow();
      });
    }

    if (closeBtn && windowEl) {
      closeBtn.addEventListener("click", () => {
        closeWindow();
      });
    }

    if (windowEl && !windowEl.classList.contains("hidden")) {
      updateTaskbarState();
    }
  };

  setupDesktopApp("recycle", "Recycle Bin", recycleIconUrl);
  setupDesktopApp("portfolio", "Portfolio", portfolioIconUrl);

  updateDesktopScale();
  window.addEventListener("resize", updateDesktopScale);
  window.visualViewport?.addEventListener("resize", updateDesktopScale);
</script>
